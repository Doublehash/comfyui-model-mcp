# Absolute path to the models directory used by your ComfyUI installation
COMFYUI_MODELS_HOST=/absolute/path/to/ComfyUI/models

# Required for Civitai file downloads. Create a read-only token in Civitai account settings.
CIVITAI_TOKEN=replace-with-your-token

# Optional Hugging Face access token for gated downloads inside the stack
HF_TOKEN=

# Optional directory for ComfyUI input/output/custom nodes/user/cache data
COMFYUI_DATA_HOST=./comfyui-data
